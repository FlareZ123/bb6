def candidate (a : Nat) : Bool :=
  ((a%64 == 9) || (a%128 == 81) || (a%64 == 53) ||
    ((a%128 == 125) && (a%1024 != 125))) &&
  (a%1024 != 253) && (a%1024 != 381) &&
  (a%1024 != 509) && (a%512 != 393) &&
  (a%512 != 265) && (a%1024 != 137) &&
  (a%1024 != 521) && (a%2048 != 1661) &&
  (a%2048 != 893) && !(blocked34 a)
def survivors : List Nat := (List.range 2048).filter candidate
set_option maxRecDepth 32768
set_option maxHeartbeats 30000000
theorem survivors_exact :
  survivors = [9, 53, 73, 81, 117, 201, 209, 245, 337, 465, 565, 585, 629, 637, 649, 721, 765, 849, 949, 1021, 1033, 1097, 1141, 1225, 1233, 1269, 1361, 1461, 1489, 1589, 1673, 1717, 1737, 1781, 1789, 1873, 1917, 1973, 2001, 2045] := by decide
theorem survivors_cardinality : survivors.length = 40 := by
  rw [survivors_exact]
  decide
#print axioms survivors_exact
#print axioms survivors_cardinality
end BB429GateArithmetic
