def tree : Tree := sub_root

def member : Tree → Nat → Bool
 | .nil, _ => false
 | .node n l r, v => if v == n then true else if v < n then member l v else member r v

def delta (st b : Nat) : Option (Nat × Bool × Nat) :=
  match st, b with
  | 0,0 => some (1,false,1)
  | 0,1 => some (0,false,4)
  | 1,0 => some (1,true,2)
  | 1,1 => some (0,false,0)
  | 2,0 => some (1,true,0)
  | 2,1 => some (1,true,3)
  | 3,0 => some (1,true,2)
  | 3,1 => some (1,true,5)
  | 4,0 => some (0,true,2)
  | 4,1 => some (0,true,1)
  | 5,0 => some (1,true,4)
  | _,_ => none

def bitAt (bits pos : Nat) : Nat := (bits / 2^pos)%2

def writeBit (bits pos w : Nat) : Nat :=
  if w == 1 then bits + (if bitAt bits pos == 0 then 2^pos else 0)
  else bits - (if bitAt bits pos == 1 then 2^pos else 0)

/-- Numeric state format: bits*256 + (head+8)*8 + state. Head 8 is the
    opaque right region, which is free to re-enter head 7 in any state. -/
def stepOK (id : Nat) : Bool := Id.run do
  let bits := id / 256
  let h := (id % 256)/8
  let st := id % 8
  if h == 16 then
    return (List.range 6).all (fun ns => member tree (bits*256+(h-1)*8+ns))
  match delta st (bitAt bits h) with
  | none => return true
  | some (w, left, ns) =>
    let nb := writeBit bits h w
    if left && h == 0 then return ns == 2
    let nh := if left then h-1 else h+1
    return member tree (nb*256+nh*8+ns)

def initial (v : Nat) : Nat := 42*256+(8*8)+4 + (v*2^9)*256

def checked : Tree → Bool
 | .nil => true
 | .node v l r => stepOK v && (checked l && checked r)

theorem checked_member : ∀ (t : Tree) (id : Nat),
    checked t = true → member t id = true → stepOK id = true := by
  intro t
  induction t with
  | nil => intro id h hm; simp [member] at hm
  | node v l r ihl ihr =>
    intro id hc hm
    have hc' : stepOK v = true ∧ checked l = true ∧ checked r = true := by
      simpa [checked, Bool.and_eq_true] using hc
    rcases hc' with ⟨hv,hl,hr⟩
    by_cases heq : id = v
    · subst id; exact hv
    · by_cases hlt : id < v
      · have hmem : member l id = true := by
          simpa [member, heq, hlt] using hm
        exact ihl id hl hmem
      · have hmem : member r id = true := by
          simpa [member, heq, hlt] using hm
        exact ihr id hr hmem

/-- Universal seven-bit initial window, for every possible right tape. -/
theorem initial_all_true :
    (List.range 128).all (fun v => member tree (initial v)) = true := by
  decide

theorem initial_all (v : Nat) (hv : v < 128) :
    member tree (initial v) = true :=
  (List.all_eq_true.mp initial_all_true) v (List.mem_range.mpr hv)

theorem node_close (v : Nat) (l r : Tree)
  (hv : stepOK v = true) (hl : checked l = true) (hr : checked r = true) :
  checked (Tree.node v l r) = true := by
  simp [checked,hv,hl,hr]

