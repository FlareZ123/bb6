theorem pre_append (u v : List Bool) (l : Tape) : pre (u++v) l = pre u (pre v l) := by
  induction u with
  | nil => rfl
  | cons b u ih => simp only [List.cons_append]; change cons b (pre (u++v) l) = cons b (pre u (pre v l)); rw [ih]

theorem zeros_blank (n : Nat) : pre (List.replicate n false) blank = blank := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.replicate_succ]
    change cons false (pre (List.replicate n false) blank) = blank
    rw [ih]
    funext i; cases i <;> rfl

