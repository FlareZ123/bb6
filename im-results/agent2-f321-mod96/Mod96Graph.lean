import Lean
import Lean.Elab.Tactic.Omega

/-!
An exact kernel-checkable 96×96 finite-state forward overapproximation
of the F321 source counter orbit AFTER the unique first source move
(1,1)->(6,1). Input graph overapproximates high, far, and both middle
choices at all residues, and equality only when x=y. Its 811-bit support
is generated by verify.cjs. The H/F branches can never be
underapproximated, even when source integer guards are removed.
-/
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace BB6.Agent2F321Mod96

def mask : Nat := 
def hit (x y:Nat) : Bool :=
  mask.testBit (96*(x%96)+(y%96))

def H (x y:Nat) : Nat×Nat :=
  ((x+192-y-2)%96,(2*y+3)%96)
def F (x y:Nat) : Nat×Nat :=
  ((4*x+6)%96,(y+288-3*x)%96)
def M1 (x y:Nat) : Nat×Nat :=
  ((4*x+6)%96,1)
def M2 (x y:Nat) : Nat×Nat :=
  ((4*x+6)%96,2)
def E (x y:Nat) : Nat×Nat :=
  ((2*x+4)%96,1)

/-- The actual finite quotient has exactly 811 live residues. Every
synthetic edge from a live residue goes into a live residue. -/
theorem closed_graph :
  ∀ x y:Fin 96, hit x.val y.val = true →
   (hit (H x.val y.val).1 (H x.val y.val).2 = true) ∧
   (hit (F x.val y.val).1 (F x.val y.val).2 = true) ∧
   (hit (M1 x.val y.val).1 (M1 x.val y.val).2 = true) ∧
   (hit (M2 x.val y.val).1 (M2 x.val y.val).2 = true) ∧
   (x.val=y.val → hit (E x.val y.val).1 (E x.val y.val).2 = true) := by
  decide +kernel

theorem seed_live : hit 6 1 = true := by decide
theorem forbidden_gate_13 : hit 14 13 = false := by decide

#print axioms closed_graph
#print axioms forbidden_gate_13
end BB6.Agent2F321Mod96
