inductive ExtraCert where
  | base (c : CompactCert)
  | erase (b : Bool)

def extraCheck (B : Nat) (p : PartialMachine) : ExtraCert → Bool
  | .base c => compactCheck B p c
  | .erase b => sameTable p (BB6Coverage.Agent23Erase.p b)

theorem extraSound (B : Nat) (p : PartialMachine) (c : ExtraCert)
    (h : extraCheck B p c = true) : Cover (WeightedBound B) p := by
  cases c with
  | base c => exact compactCheck_sound B p c h
  | erase b =>
    have he : p = BB6Coverage.Agent23Erase.p b := sameTable_sound _ _ h
    rw [he]
    exact .leaf _ (fun m hm => weighted_of_never B m
      (BB6Coverage.Agent23Erase.never b m hm))

