TM63Uniform.Cfg : Type
TM63Uniform.rawStart : Nat → Nat → List Bool → List Bool → TM63Uniform.Cfg
TM63Uniform.rawEnd : Nat → Nat → List Bool → List Bool → TM63Uniform.Cfg
TM63Uniform.counted_all (k c : Nat) (ls rs : List Bool) :
  TM63Uniform.run (48 + 12 * k + 12 * c) (TM63Uniform.rawStart k c ls rs) = TM63Uniform.rawEnd k c ls rs
TM63Uniform.counted_no_early_halt (k c : Nat) (ls rs : List Bool) (t : Nat) (ht : t ≤ 48 + 12 * k + 12 * c) :
  ¬((TM63Uniform.run t (TM63Uniform.rawStart k c ls rs)).st = 0 ∧
      (TM63Uniform.run t (TM63Uniform.rawStart k c ls rs)).h = true)
