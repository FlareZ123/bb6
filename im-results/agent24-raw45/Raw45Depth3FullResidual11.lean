def parent : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩) | (0,true) => none
  | (1,false) => some (some ⟨true,true,2⟩) | (1,true) => some (some ⟨true,true,4⟩)
  | (2,false) => some (some ⟨false,true,3⟩) | (2,true) => none
  | (3,false) => some (some ⟨true,false,3⟩) | (3,true) => some (some ⟨true,true,1⟩)
  | (4,false) => some (some ⟨false,false,5⟩) | (4,true) => some (some ⟨false,false,4⟩)
  | (5,false) => none | (5,true) => none
  | _ => none
theorem parent_root : parent initialSlot = some (some ⟨true,true,1⟩) := by decide
theorem parent_nohalt : weightedTNFNoAssignedHalt parent := by
  intro slot
  rcases slot with ⟨q,b⟩
  have hq : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
  rcases hq with rfl|rfl|rfl|rfl|rfl|rfl <;> cases b <;> decide
def ngramP : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩) | (0,true) => none
  | (1,false) => some (some ⟨true,true,2⟩) | (1,true) => some (some ⟨true,true,4⟩)
  | (2,false) => some (some ⟨false,true,3⟩) | (2,true) => some (some ⟨false,true,1⟩)
  | (3,false) => some (some ⟨true,false,3⟩) | (3,true) => some (some ⟨true,true,1⟩)
  | (4,false) => some (some ⟨false,false,5⟩) | (4,true) => some (some ⟨false,false,4⟩)
  | (5,false) => some (some ⟨true,false,1⟩) | (5,true) => some (some ⟨true,false,4⟩)
  | _ => none
def ngramC : Cert := ⟨0,0xf,0xf,#[.leaf,.empty,(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .empty .leaf) (.branch .empty .leaf)),(.branch (.branch .empty .leaf) (.branch .empty .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) .empty),(.branch (.branch .leaf .leaf) .empty)]⟩
theorem ngram_ok : check ngramP ngramC = true := by decide
theorem ngram_never (m : Machine) (hm : compatible ngramP m) : NeverHalts m :=
  never ngramP ngramC ngram_ok m hm
