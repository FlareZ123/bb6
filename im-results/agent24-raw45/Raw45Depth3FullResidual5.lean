def parent : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩)
  | (0,true) => none
  | (1,false) => some (some ⟨true,true,2⟩)
  | (1,true) => some (some ⟨false,false,2⟩)
  | (2,false) => some (some ⟨false,true,3⟩)
  | (2,true) => some (some ⟨false,false,4⟩)
  | (3,false) => some (some ⟨true,false,3⟩)
  | (3,true) => some (some ⟨true,true,1⟩)
  | (4,false) => none
  | (4,true) => some (some ⟨false,true,4⟩)
  | (5,false) => none
  | (5,true) => none
  | _ => none

theorem parent_root : parent initialSlot = some (some ⟨true,true,1⟩) := by decide
theorem parent_nohalt : weightedTNFNoAssignedHalt parent := by
  intro slot
  rcases slot with ⟨q,b⟩
  have hq : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
  rcases hq with rfl|rfl|rfl|rfl|rfl|rfl <;> cases b <;> decide

def ngramP0 : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩) | (0,true) => none
  | (1,false) => some (some ⟨true,true,2⟩) | (1,true) => some (some ⟨false,false,2⟩)
  | (2,false) => some (some ⟨false,true,3⟩) | (2,true) => some (some ⟨false,false,4⟩)
  | (3,false) => some (some ⟨true,false,3⟩) | (3,true) => some (some ⟨true,true,1⟩)
  | (4,false) => some (some ⟨false,false,5⟩) | (4,true) => some (some ⟨false,true,4⟩)
  | (5,false) => some (some ⟨true,true,4⟩) | (5,true) => some (some ⟨true,false,5⟩)
  | _ => none
def ngramP1 : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩) | (0,true) => none
  | (1,false) => some (some ⟨true,true,2⟩) | (1,true) => some (some ⟨false,false,2⟩)
  | (2,false) => some (some ⟨false,true,3⟩) | (2,true) => some (some ⟨false,false,4⟩)
  | (3,false) => some (some ⟨true,false,3⟩) | (3,true) => some (some ⟨true,true,1⟩)
  | (4,false) => some (some ⟨false,false,5⟩) | (4,true) => some (some ⟨false,true,4⟩)
  | (5,false) => some (some ⟨true,true,5⟩) | (5,true) => some (some ⟨false,true,1⟩)
  | _ => none
def ngramC0 : Cert := ⟨0,0xf,0xf,#[.leaf,.empty,(.branch (.branch .empty .leaf) (.branch .empty .leaf)),(.branch (.branch .empty .leaf) (.branch .empty .leaf)),(.branch (.branch .empty .leaf) (.branch .empty .leaf)),(.branch (.branch .leaf .leaf) (.branch .empty .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf))]⟩
def ngramC1 : Cert := ⟨0,0xf,0xf,#[.leaf,.empty,(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) (.branch .empty .leaf)),(.branch (.branch .leaf .leaf) (.branch .empty .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch .leaf (.branch .leaf .leaf)),(.branch (.branch .leaf .leaf) .leaf),(.branch (.branch .leaf .leaf) .empty),(.branch (.branch .leaf .leaf) (.branch .empty .leaf)),(.branch (.branch .leaf .leaf) (.branch .empty .leaf))]⟩
theorem ngram_ok0 : check ngramP0 ngramC0 = true := by decide
theorem ngram_ok1 : check ngramP1 ngramC1 = true := by decide
theorem ngram_never0 (m : Machine) (hm : compatible ngramP0 m) : NeverHalts m :=
  never ngramP0 ngramC0 ngram_ok0 m hm
theorem ngram_never1 (m : Machine) (hm : compatible ngramP1 m) : NeverHalts m :=
  never ngramP1 ngramC1 ngram_ok1 m hm

