import BB429ResonanceErrorBand

namespace BB429.CoarseExit

set_option maxHeartbeats 20000000


/-- A minimal d=234 second-resonance word is exponentially shorter than its
    scale.  The deliberately weak linear consequence m ≥ 5i+61 is already
    enough to make the final geometric-cycle margin enormous. -/
theorem d234_minimal_scale_gap
    (i m : Nat) (e : Nat → Bool)
    (hi7 : 7≤i) (hfirst : e 0=true)
    (hres :
      (2496:Int)*(m:Int)+23808 =
        36+108*word4 e i) :
    5*i+61≤m := by
  have hw := word4_first_true e i (by omega) hfirst
  have hp := pow4_ge_500_index i hi7
  have hp' : (500:Int)*(i:Int)≤(4:Int)^(i-1) := by
    exact_mod_cast hp
  have hb : (500:Int)*(i:Int)≤word4 e i := by omega
  have hiI : (7:Int)≤(i:Int) := by exact_mod_cast hi7
  have hmI : (5:Int)*(i:Int)+61≤(m:Int) := by
    omega
  exact_mod_cast hmI


theorem pow16_ge_100_index (n : Nat) (hn : 2≤n) :
    100*n≤16^n := by
  obtain ⟨k,rfl⟩ : ∃ k, n=2+k := ⟨n-2,by omega⟩
  induction k with
  | zero => decide
  | succ k ih =>
      rw [show 2+(k+1)=(2+k)+1 by omega,Nat.pow_succ]
      omega

/-- The linear V-error budget after a minimal resonance is tiny compared
    with the geometric margin generated by the remaining scale gap. -/
theorem d234_margin_growth (i m : Nat) (hgap : 5*i+61≤m) :
    60*m+254 ≤ 16*i+4*16^(m-i) := by
  have hmi : i≤m := by omega
  let n := m-i
  have hn : 2≤n := by dsimp [n]; omega
  have hm : m=n+i := by dsimp [n]; omega
  have hni : 4*i+61≤n := by dsimp [n]; omega
  have hp := pow16_ge_100_index n hn
  have hlin : 60*n+44*i+254≤71*n := by omega
  have hh : 71*n≤4*16^n := by omega
  rw [hm]
  dsimp [n] at hh ⊢
  omega


/-- Scalar endgame after the minimal-resonance error estimate.  Here
    N=16^(m-i), X=16^m, D is the final geometric deviation after J cycles,
    and C is the cycle invariant.  The resonance band alone places (C,D)
    in the exact strip required by phase_cycles_direct_return. -/
theorem d234_scalar_window_arith
    (i m J : Nat) (H N X d0 D C q : Int)
    (hJnat : J=m-i+1) (hJ : 1≤J)
    (hN : 1≤N) (hXpos : 1≤X)
    (hX : X=H*H*N)
    (hD : D=16*d0*N)
    (hlo : 18*H*H < 16*d0)
    (hhi : 4*d0≤9*H*H)
    (hq0 : 0≤q)
    (hqhi : q≤36*(m:Int)+259+8*(i:Int))
    (hC : C=72*X+q-2+24*(J:Int))
    (hmargin : 60*(m:Int)+254≤16*(i:Int)+4*N) :
    D≤36*X ∧ 72*X≤C ∧ C≤4*D+27 ∧ 8*D+21≤5*C := by
  have hN0 : 0≤N := by omega
  have hhiN := Int.mul_le_mul_of_nonneg_right hhi hN0
  have hDhi : D≤36*X := by
    rw [hD,hX]
    grind +ring
  have hlo' : 18*H*H+1≤16*d0 := by omega
  have hloN := Int.mul_le_mul_of_nonneg_right hlo' hN0
  have hDlo : 18*X+N≤D := by
    rw [hD,hX]
    grind +ring
  have hJcast : (J:Int)=(m:Int)-(i:Int)+1 := by
    have hmi : i≤m+1 := by omega
    exact_mod_cast hJnat
  have hClo : 72*X≤C := by
    rw [hC,hJcast]
    omega
  have hCoff :
      C≤72*X+4*N+27 := by
    rw [hC,hJcast]
    omega
  have hChi : C≤4*D+27 := by
    omega
  have hlast : 8*D+21≤5*C := by
    omega
  exact ⟨hDhi,hClo,hChi,hlast⟩

/-- The abstract error band specialized to a *minimal* d=234 doubled-scale
    resonance word.  Minimal means the first temporal base-four digit is
    true; for length at least seven this alone supplies all large-scale
    inequalities required by d234_error_band_arith. -/
theorem d234_minimal_phase_error_band
    (i m n : Nat) (P r : Int)
    (U V : Nat → Int) (e ph : Nat → Bool)
    (hi7 : 7≤i) (hin : i≤n) (hfirst : e 0=true)
    (hres :
      (2496:Int)*(m:Int)+23808 =
        36+108*word4 e i)
    (hU : U 0=((2496:Int)*(m:Int)+23808)*P)
    (hV : V 0=r*P+(108*(m:Int)+777-18*(i:Int)))
    (hs : PhaseBlocks U V e ph n) :
    let x := U i-lead r ((2496:Int)*(m:Int)+23808) e i*P
    let z := V i-r*P
    let dc := -6*x+4*z+12
    let H := (4:Int)^i
    54*H*H < 16*dc ∧ 4*dc≤27*H*H := by
  dsimp only
  let b := word4 e i
  let H : Int := 4^i
  let y : Int := 108*(m:Int)+777-18*(i:Int)
  have hb := word4_bound e i
  have hfirst' := word4_first_true e i (by omega) hfirst
  have hp500 := pow4_ge_500_index i hi7
  have hp500' : (500:Int)*(i:Int)≤(4:Int)^(i-1) := by
    exact_mod_cast hp500
  have hHstep : H=4*(4:Int)^(i-1) := by
    dsimp [H]
    rw [show i=(i-1)+1 by omega,Int.pow_succ]
    ring
  have hhlo : H≤4*b := by
    dsimp [b]
    rw [hHstep]
    omega
  have hh0 : 0≤H := Int.pow_nonneg (by decide)
  have hhhi : 3*b+1≤H := by
    dsimp [b,H]
    exact hb.2
  have hlo : 500*(i:Int)≤b := by
    dsimp [b]
    omega
  have hbig : (3500:Int)≤b := by
    have hiI : (7:Int)≤(i:Int) := by exact_mod_cast hi7
    omega
  have hb0 : 0≤b := by dsimp [b]; exact hb.1
  have hrel : 9*b=208*(m:Int)+1981 := by
    dsimp [b] at hres ⊢
    omega
  have herr := phase_error_bounds P r
    ((2496:Int)*(m:Int)+23808) y n U V e ph
    (by simpa [y] using hU) (by simpa [y] using hV) hs i hin
  obtain ⟨hzlo,hzhi,hxlo,hxhi⟩ := herr
  exact d234_error_band_arith i m b H y
    (U i-lead r ((2496:Int)*(m:Int)+23808) e i*P)
    (V i-r*P)
    (-6*(U i-lead r ((2496:Int)*(m:Int)+23808) e i*P)+
      4*(V i-r*P)+12)
    hi7 hb0 hlo hbig hhlo hh0 hhhi hrel rfl
    hxlo hxhi hzlo hzhi rfl

