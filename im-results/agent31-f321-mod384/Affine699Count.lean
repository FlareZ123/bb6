def broadOld (r : Nat) : Bool :=
 (r % 6144 == 3787) || (r % 12288 == 7933)

/-- Test whether a *whole* modulus-49152 parameter progression is already
    excluded by an earlier base-four inverse family. As 49152/8=6144 is
    divisible by 4^5, the first five low base-four digits of (d-3)/8
    are fixed throughout such a progression. No tail-conditional rule
    is called fully excluded. -/
def base4Old (r : Nat) : Bool :=
 if r%8 != 3 then false else
 let k := (r-3)/8
 let d0 := k%4
 let d1 := (k/4)%4
 let d2 := (k/16)%4
 let d3 := (k/64)%4
 let d4 := (k/256)%4
 if d0 == 2 then
   if d1 == 2 then
     if d2 == 2 then
       if d3 == 2 then
         if d4 == 2 then false else (d4 == 0 || d4 == 3)
       else (d3 == 0 || d3 == 1)
     else (d2 == 0 || d2 == 3)
   else (d1 == 0 || d1 == 1)
 else (d0 == 0 || d0 == 3)

/-- Exactly 699 distinct representatives, all in the strict range. -/
theorem all_count : rays.length = 699 := by decide
theorem all_distinct : rays.Nodup := by decide +kernel
theorem all_lt_modulus : ∀ r ∈ rays, r < 49152 := by decide +kernel
/-- Every proposed residue is *not* already excluded by the kernel-accepted
    modulo-384 source forward graph. -/
theorem all_inside_mod384_candidate :
 ∀ r ∈ rays, r%384 ∈ acceptedMod384GateClasses := by decide +kernel
/-- There are exactly 12 duplicate subrays of earlier broad source proofs. -/
theorem old_broad_count :
 (rays.filter fun r => broadOld r).length = 12 := by decide +kernel
/-- Exactly 20 other generated rays are already contained in previously
    accepted base-four inverse exclusions. -/
theorem old_base4_count :
 (rays.filter fun r => base4Old r).length = 20 := by decide +kernel
theorem prior_overlap_disjoint :
 (rays.filter fun r => broadOld r && base4Old r).length = 0 := by decide +kernel
/-- The arithmetic contribution of the batch is precisely 667 genuinely
    additional distinct full residue progressions modulo 49152. -/
theorem new_full_rays_count :
 (rays.filter fun r => !(broadOld r || base4Old r)).length = 667 := by decide +kernel

