import Lean
import Lean.Elab.Tactic.Omega

/-!
F321 rigorous finite forward overapproximation modulo 384. The middle
output is parity-selected (unlike the earlier looser modulo-96 graph).
For every authentic source map step, its residue has an edge here.
Generated by verify.cjs, kernel-checked by closed_graph.
-/
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace BB6.Agent31F321Mod384

def mask : Nat := 

def hit (x y : Nat) : Bool := mask.testBit (384*(x%384)+(y%384))

def H (x y : Nat) : Nat × Nat := ((x+768-y-2)%384,(2*y+3)%384)
def F (x y : Nat) : Nat × Nat := ((4*x+6)%384,(y+1152-3*x)%384)
def M1 (x y : Nat) : Nat × Nat := ((4*x+6)%384,1)
def M2 (x y : Nat) : Nat × Nat := ((4*x+6)%384,2)
def E (x y : Nat) : Nat × Nat := ((2*x+4)%384,1)

/-- Every abstract move preserves a live residue; only middle parity
    is retained as a guard, besides equality for E. -/
theorem closed_graph :
  ∀ x y : Fin 384, hit x.val y.val = true →
   (hit (H x.val y.val).1 (H x.val y.val).2 = true) ∧
   (hit (F x.val y.val).1 (F x.val y.val).2 = true) ∧
   ((x.val+y.val)%2=1 → hit (M1 x.val y.val).1 (M1 x.val y.val).2 = true) ∧
   ((x.val+y.val)%2=0 → hit (M2 x.val y.val).1 (M2 x.val y.val).2 = true) ∧
   (x.val=y.val → hit (E x.val y.val).1 (E x.val y.val).2 = true) := by
  decide +kernel

theorem seed_live : hit 6 1 = true := by decide

theorem forbidden_gate_373 : hit 374 373 = false := by decide

/-- Exact finite enumeration of the 15 terminal residues still admitted
    by this conservative forward graph. No assertion that any is reached. -/
def possibleGates : List Nat := [37,61,115,133,139,157,181,211,229,235,253,277,325,331,349]
theorem gate_table_complete :
 ∀ r : Fin 384, hit ((r.val+1)%384) r.val = true →
     r.val ∈ possibleGates := by decide +kernel

#print axioms closed_graph
#print axioms forbidden_gate_373
#print axioms gate_table_complete
end BB6.Agent31F321Mod384
