theorem tree_checked : check 92 parent tree = true := by decide

noncomputable def certificate : WeightedTNFCertificate 92 parent 6 :=
  certified 92 parent tree parent_root parent_nohalt tree_checked

theorem all_completions_weighted : ∀ m, compatible parent m → WeightedBound 92 m :=
  certificate.sound

theorem attained : ∃ m, compatible parent m ∧ HaltsAfter m 91 := by
  let p := refine parent (5,false) (some ⟨true,true,0⟩)
  let p' := refine p (0,true) (some ⟨false,false,5⟩)
  let m := weightedTNFDefaultCompletion (refine p' (4,false) none)
  have hh0 : parent (5,false) = none := by decide
  have hh1 : p (0,true) = none := by decide
  have hh2 : p' (4,false) = none := by decide
  have hr : (knownRun p' 91).map readSlot = some (4,false) := by decide
  have hm : compatible (refine p' (4,false) none) m :=
    weightedTNFDefaultCompletion_compatible _
  have hp' : compatible p' m := refine_preserves_compat p' m (4,false) none hh2 hm
  have hp : compatible p m := refine_preserves_compat p m (0,true) (some ⟨false,false,5⟩) hh1 hp'
  have hpar : compatible parent m := refine_preserves_compat parent m (5,false) (some ⟨true,true,0⟩) hh0 hp
  refine ⟨m,hpar,?_⟩
  cases hrun : knownRun p' 91 with
  | none => simp [hrun] at hr
  | some c =>
    have hs : readSlot c = (4,false) := by simpa [hrun] using hr
    apply first_hole_halts p' 91 c hrun
    · simpa [hs] using hh2
    · simpa [hs] using hm

theorem exact_weighted_threshold (B : Nat) :
    (∀ m, compatible parent m → WeightedBound B m) ↔ 92 ≤ B := by
  constructor
  · intro h
    obtain ⟨m,hm,hh⟩ := attained
    have hz := firstOne_terminal parent parent_root m hm
    have hd : 0 ∈ delays (zeroNext m) 0 :=
      (mem_delays_iff hz).mpr ⟨0, TerminalPath.stop 0 hz⟩
    have hb := h m hm 91 0 hh hd
    omega
  · intro hb m hm k d hk hd
    exact Nat.le_trans (all_completions_weighted m hm k d hk hd) hb

