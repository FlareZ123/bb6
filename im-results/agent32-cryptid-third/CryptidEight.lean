import Lean.Elab.Tactic.Omega
import CryptidSix

set_option maxHeartbeats 5000000
namespace CryptidBoundary

/-- A second mixed-boundary word, generated by the proven six-one return. -/
def eEight (m : Nat) (ys : List Bool) : Cfg :=
  ⟨false::false::pairs m ++ [true,true], false,
    [true,false,true,false,true,true,true,false] ++ ys, 4⟩

def packetEight : List Bool :=
  [false,true,false,true,false,true,false,true,false,false]

/-- Entire fixed 28-step interpreter of the eight-symbol E input. -/
theorem eEight_front (m : Nat) (ys : List Bool) :
  run 28 (eEight m ys) = sweepB m (packetEight ++ ys) := by
  simp [eEight, sweepB, packetEight, run, step, goL, goR,
    pairs, List.append_assoc]

/-- Complete exact original-machine return for every alternating-stack length. -/
theorem eEight_run (m : Nat) (ys : List Bool) :
  run (2*m+31) (eEight m ys) =
    ⟨[], false, List.replicate (2*m+3) true ++
      (packetEight ++ ys), 5⟩ := by
  have ht : 2*m+31 = 28+(2*m+3) := by omega
  rw [ht, run_add, eEight_front, sweepB_run]

/-- Direct original-source F-to-F return for the eight-symbol suffix. -/
theorem full_E_eight (k : Nat) (ys : List Bool) :
  run (12*k*k+49*k+70)
    (init (List.replicate (3*k+2) true ++
      false :: ([true,false,true,false,true,true,true,false] ++ ys))) =
    ⟨[], false, List.replicate (8*k+9) true ++
      (packetEight ++ ys), 5⟩ := by
  have ht : 12*k*k+49*k+70 =
    (12*k*k+41*k+33)+(2*(4*k+3)+31) := by omega
  rw [ht, run_add, prefix_E]
  change run (2*(4*k+3)+31) (eEight (4*k+3) ys) = _
  rw [eEight_run]
  rw [show 2*(4*k+3)+3 = 8*k+9 by omega]

#print axioms eEight_front
#print axioms eEight_run
#print axioms full_E_eight
end CryptidBoundary
