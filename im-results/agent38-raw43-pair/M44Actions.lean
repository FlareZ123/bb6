def isLeft (q : Nat) : Bool := q == 10 || q == 11
def putBack (b : Nat) (s : List Nat) := if b == 17 then s else b::s
def beforeL (q b : Nat) (s : List Nat) := if isLeft q then putBack b s else s
def beforeR (q b : Nat) (d : List Nat) := if isLeft q then d else putBack b d
def endOK (q b : Nat) (s d : List Nat) : Prop :=
  b = 17 → if isLeft q then s = [] else d = []
def well (q : Nat) (s : List Nat) : Prop := (q = 12 ∨ q = 13) → s = []
def padNext (p z : Nat) : Nat :=
  match p with
  | 1 => z-3
  | 2 => z-4
  | 3 => z+3
  | _ => z

def interpret (q : Nat) (s d : List Nat) (j z : Nat) : Z0 :=
  match q with
  | 0 => rawF s d j z
  | 1 => rawF s (1::d) j z
  | 2 => rawF s (2::d) j z
  | 3 => rawF s (1::0::d) j z
  | 4 => rawF s (1::2::d) j z
  | 5 => rawF s (1::3::d) j z
  | 6 => rawF s (1::3::1::d) j z
  | 7 => rawF s (1::3::1::2::d) j z
  | 8 => rawF s (2::1::d) j z
  | 9 => rawF s (2::1::2::d) j z
  | 10 => rawA s d j z
  | 11 => rawA (0::s) d j z
  | 12 => rawA s d j z
  | 13 => rawA s (6::d) j z
  | _ => rawF s d j z

def rank (q : Nat) : Nat :=
  match q with
  | 0 | 10 => 6
  | 1 | 2 | 11 | 12 => 5
  | 3 | 4 | 5 | 8 | 13 => 4
  | 6 | 9 => 3
  | 7 => 2
  | _ => 0

theorem rank_le (q : Nat) : rank q ≤ 6 := by
  unfold rank
  split <;> omega

def cost (a : Act) (j : Nat) := a.cost + a.slope*j
