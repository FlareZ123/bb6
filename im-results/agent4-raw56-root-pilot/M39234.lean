-- Canonical section: C scans the first zero, with exactly one 1 to its left.
def Z4 : List Bool := [false,false,false,false]
def W4 : List Bool := [true,true,true,true]
def K : List Bool := [false,false,true,true,true,true]
def base : List Bool := [false,true,true,true,true,true,true,true,true,false,false,false,false,false,false,true,true,true,true]
def tailWord : List (Nat × Nat) → List Bool
  | [] => []
  | (a,b)::S => Z4 ++ (rep Z4 a ++ (W4 ++ (rep W4 b ++ tailWord S)))
def P (n : Nat) (X : List Bool) : Z0 := ⟨2,[false,true],base ++ (rep K n ++ X)⟩
def G0 (n k : Nat) (S : List (Nat × Nat)) : Z0 := P n ([false,false,false,false,false,false,true,true,true,true,false,false,false,false,false,false,false,true,true,true,true] ++ (rep W4 k ++ tailWord S))
def G1 (n k : Nat) (S : List (Nat × Nat)) : Z0 := P n ([false,false,true,true,true,true,true,true,true,true,false,false,true,true,true,true,false,false,false,false,false,false,false,true,true,true,true] ++ (rep W4 k ++ tailWord S))
def G2 (n k : Nat) (S : List (Nat × Nat)) : Z0 := P n ([false,false,false,false,false,false,true,true,true,true,true,true,true,true,false,false,false,true,true,true,true] ++ (rep W4 k ++ tailWord S))
def G3 (n k : Nat) (S : List (Nat × Nat)) : Z0 := P n ([false,false,true,true,true,true,true,true,true,true,false,false,true,true,true,true,true,true,true,true,false,false,false,true,true,true,true] ++ (rep W4 k ++ tailWord S))

theorem rep_add (W : List Bool) (n k : Nat) : rep W (n+k) = rep W n ++ rep W k := by
  induction n with
  | zero => simp [rep.eq_1]
  | succ n ih => rw [show n+1+k=n+k+1 by omega,rep.eq_2,ih,rep.eq_2,List.append_assoc]

-- Parameter offsets k,a,b count extra four-cell blocks (so all runs are positive).
theorem ret0 (n k : Nat) (S : List (Nat × Nat)) : run0 table (86+6*n+17+10*n+63) (G0 n k S) = some (G1 n k S) := by
  exact phase0 n (rep W4 k ++ tailWord S)

theorem ret1 (n k : Nat) (S : List (Nat × Nat)) : run0 table (86+6*n+45+10*n+75) (G1 n k S) = some (G2 (n+2) k S) := by
  unfold G1 G2 P
  rw [rep_add K n 2]
  simpa only [base,K,W4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase1 n (rep W4 k ++ tailWord S)

theorem ret2 (n k : Nat) (S : List (Nat × Nat)) : run0 table (86+6*n+17+10*n+63) (G2 n k S) = some (G3 n k S) := by
  exact phase2 n (rep W4 k ++ tailWord S)

def finishParams (k : Nat) (S : List (Nat × Nat)) : Nat × List (Nat × Nat) :=
  match k,S with
  | 0,[] => (1,[])
  | m+1,[] => (0,[(m,0)])
  | 0,(0,b)::T => (b+2,T)
  | m+1,(0,b)::T => (0,(m,b+1)::T)
  | 0,(a+1,b)::T => (1,(a,b)::T)
  | m+1,(a+1,b)::T => (0,(m,0)::(a,b)::T)

def finishCost (n k : Nat) : Nat := match k with
  | 0 => 86+6*n+73+10*n+75
  | m+1 => 86+6*n+37+4*m+13+4*m+31+10*n+75

theorem ret3 (n k : Nat) (S : List (Nat × Nat)) : run0 table (finishCost n k) (G3 n k S) = some (G0 (n+2) (finishParams k S).1 (finishParams k S).2) := by
  cases k with
  | zero =>
    cases S with
    | nil =>
      simp only [G3,G0,P,finishCost,finishParams]
      rw [rep_add K n 2]
      simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_1_nil n
    | cons h T =>
      rcases h with ⟨a,b⟩
      cases a with
      | zero =>
        simp only [G3,G0,P,finishCost,finishParams]
        rw [rep_add K n 2]
        simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_1_one n (rep W4 b ++ tailWord T)
      | succ a =>
        simp only [G3,G0,P,finishCost,finishParams]
        rw [rep_add K n 2]
        simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_1_many n a (rep W4 b ++ tailWord T)
  | succ m =>
    cases S with
    | nil =>
      simp only [G3,G0,P,finishCost,finishParams]
      rw [rep_add K n 2]
      simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_2_nil m n
    | cons h T =>
      rcases h with ⟨a,b⟩
      cases a with
      | zero =>
        simp only [G3,G0,P,finishCost,finishParams]
        rw [rep_add K n 2]
        simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_2_one m n (rep W4 b ++ tailWord T)
      | succ a =>
        simp only [G3,G0,P,finishCost,finishParams]
        rw [rep_add K n 2]
        simpa only [tailWord,base,K,W4,Z4,rep.eq_2,rep.eq_1,List.append_assoc,List.cons_append,List.nil_append,List.append_nil] using phase3_2_many m n a (rep W4 b ++ tailWord T)

inductive Inv : Z0 → Prop
  | phase0 (n k : Nat) (S : List (Nat × Nat)) : Inv (G0 n k S)
  | phase1 (n k : Nat) (S : List (Nat × Nat)) : Inv (G1 n k S)
  | phase2 (n k : Nat) (S : List (Nat × Nat)) : Inv (G2 n k S)
  | phase3 (n k : Nat) (S : List (Nat × Nat)) : Inv (G3 n k S)

theorem closed (z : Z0) (hz : Inv z) : ∃ t w, 0 < t ∧ run0 table t z = some w ∧ Inv w := by
  cases hz with
  | phase0 n k S => exact ⟨_,_,by omega,ret0 n k S,Inv.phase1 n k S⟩
  | phase1 n k S => exact ⟨_,_,by omega,ret1 n k S,Inv.phase2 (n+2) k S⟩
  | phase2 n k S => exact ⟨_,_,by omega,ret2 n k S,Inv.phase3 n k S⟩
  | phase3 n k S => exact ⟨_,_,by cases k <;> simp only [finishCost] <;> omega,ret3 n k S,Inv.phase0 (n+2) _ _⟩

theorem entry : run0 table 1533 ⟨0,[],[]⟩ = some (G0 5 0 []) := by rfl

theorem live (k : Nat) : ∃ t z, k ≤ t ∧ run0 table t ⟨0,[],[]⟩ = some z ∧ Inv z := by
  induction k with
  | zero => exact ⟨_,_,by omega,entry,Inv.phase0 5 0 []⟩
  | succ k ih =>
    obtain ⟨t,z,ht,hr,hz⟩ := ih
    obtain ⟨u,w,hu,hs,hw⟩ := closed z hz
    exact ⟨t+u,w,by omega,join0 hr hs,hw⟩

theorem never (m : Machine) (hm : compatible table m) : NeverHalts m := by
  intro k
  obtain ⟨t,z,ht,hr,_⟩ := live k
  have hz : (zrun table t start).map project = some z := (run_project table t start).trans hr
  cases h : zrun table t start with
  | none => simp [h] at hz
  | some zz =>
    have H := zrun_sound table m hm t start zz h
    rw [start_embed] at H
    rw [show t=k+(t-k) by omega,run_append] at H
    cases he : run m k blank with
    | none => simp [he] at H
    | some c => rfl

theorem cover_never : Cover NeverHalts table := Cover.leaf table never
