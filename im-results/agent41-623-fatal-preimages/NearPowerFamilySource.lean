import NearPowerFamilyCore
import NearPowerSymbolicSource
import NearPowerExamples

namespace BB6.Agent41NearPower
open BB6.Agent41FatalInverse BB6.Agent49ParitySource
open BusyBeaver.M_1RB0LE_0RC1RC_0RD1LA_1LD0LA_1LF1LC_HHH0LA

def familyExponent (R : Nat) (off : Int) (n : Nat) : Nat := ((symFatal R off).k.eval n).toNat

theorem familyExponent_formula (R : Nat) (off : Int) (n : Nat) :
    familyExponent R off n=((6:Int)*3^(R+2*n)+off).toNat := by
  unfold familyExponent symFatal Aff.eval
  simp only [Int.zero_mul,Int.add_zero]
  rw [pow9_eq,Int.pow_add,Int.mul_assoc]

theorem family_guard (f : CertifiedFamily) : symGuard (symFatal f.R f.off)=true := by
  have h := f.accepted
  cases hc : f.cert with
  | stop => simp [hc,symCheck] at h
  | fork wl wr l r =>
    simp only [hc,symCheck,Bool.and_eq_true] at h
    exact h.1.1.1

theorem family_large (f : CertifiedFamily) (n : Nat) : 8≤familyExponent f.R f.off n := by
  have h := family_guard f
  simp only [symGuard,Bool.and_eq_true] at h
  have hh := ge_sound h.1.1.2 n
  unfold familyExponent
  omega

theorem symFatal_atN (R : Nat) (off : Int) (n : Nat) (hp : 8≤familyExponent R off n) :
    (symFatal R off).atN n=fatalState (familyExponent R off n) := by
  have h : 0≤(symFatal R off).k.eval n := by unfold familyExponent at hp; omega
  have hc := Int.toNat_of_nonneg h
  change ((symFatal R off).atN n) = fatalState ((symFatal R off).k.eval n).toNat
  unfold SymState.atN fatalState
  change NearState.mk 1 13 ((symFatal R off).k.eval n).toNat ((ac (-5)).eval n) ((ac 7-(4:Int)*(symFatal R off).k).eval n) = _
  simp only [eval_ac,eval_sub,eval_scale,hc]

/-- Every member of every accepted family is excluded at every original-source
blank-origin return index. The certificate can be generated by any algorithm. -/
theorem family_excluded (f : CertifiedFamily) (n i : Nat) :
    run i≠some (.D (targetX (familyExponent f.R f.off n-1))
                   (targetY (familyExponent f.R f.off n-1))) := by
  let p := familyExponent f.R f.off n
  have hp : 8≤p := family_large f n
  have he : p-1+1=p := by omega
  have hr := fatalState_rep (p-1) (by omega)
  rw [he,←symFatal_atN f.R f.off n hp] at hr
  exact symCheck_excludes f.cert _ n _ _ hr f.accepted i

#print axioms family_excluded
end BB6.Agent41NearPower
