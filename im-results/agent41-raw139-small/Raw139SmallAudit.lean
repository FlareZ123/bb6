/-- A partial version of the existing three-hole Audit. Open leaves remain explicit. -/
inductive PartialAudit where
  | unresolved
  | closed (a : Audit)
  | split (n : Nat) (s : Slot) (kids : Move → PartialAudit)

def validate (B : Nat) (p : PartialMachine) : PartialAudit → Bool
  | .unresolved => true
  | .closed a => check B p a
  | .split n s kids => queryOK B p n s &&
      BB6.Agent31ThreeHole.allMoves (fun mv => validate B (refine p s (some mv)) (kids mv))
termination_by structural t => t

def remaining (p : PartialMachine) : PartialAudit → List (List Move × PartialMachine)
  | .unresolved => [([],p)]
  | .closed _ => []
  | .split _ s kids =>
      BB6.Agent31FourHoleFrontier.allMoves.flatMap fun mv =>
        (remaining (refine p s (some mv)) (kids mv)).map fun e => (mv :: e.1,e.2)
termination_by structural t => t

theorem refine_compatible_at (p : PartialMachine) (m : Machine) (s : Slot)
    (t : Option Move) (hm : compatible p m) (hstep : m s = t) :
    compatible (refine p s t) m := by
  intro x u hu
  by_cases he : x = s
  · subst x
    have ht : u = t := by simpa [refine] using hu.symm
    simpa [ht] using hstep
  · exact hm x u (by simpa [refine, he] using hu)

/-- The finite audit closes exactly the proved branches; all others remain in the list. -/
theorem sound (B : Nat) (p : PartialMachine) (t : PartialAudit)
    (hroot : p initialSlot = some (some ⟨true,true,1⟩))
    (hno : weightedTNFNoAssignedHalt p)
    (h : validate B p t = true) :
    ∀ m, compatible p m →
      WeightedBound B m ∨ ∃ e ∈ remaining p t, compatible e.2 m := by
  induction t generalizing p with
  | unresolved =>
    intro m hm
    exact Or.inr ⟨([],p), by simp [remaining], hm⟩
  | closed a =>
    intro m hm
    exact Or.inl ((certified B p a hroot hno h).sound m hm)
  | split n s kids ih =>
    intro m hm
    have hv : queryOK B p n s = true ∧
        BB6.Agent31ThreeHole.allMoves
          (fun mv => validate B (refine p s (some mv)) (kids mv)) = true := by
      simpa only [validate, Bool.and_eq_true] using h
    obtain ⟨hread,hhole,hw⟩ := queryOK_sound hv.1
    cases hr : knownRun p n with
    | none => simp [hr] at hread
    | some c =>
      have hs : readSlot c = s := by simpa [hr] using hread
      cases hstep : m s with
      | none =>
        have hcomp := refine_compatible_at p m s none hm hstep
        exact Or.inl (first_hole_weighted_halt B p n c hroot hr
          (by simpa [hs] using hhole)
          (by simpa [hs] using weightOK_sound p s n B hw) m
          (by simpa [hs] using hcomp))
      | some mv =>
        have hcomp := refine_compatible_at p m s (some mv) hm hstep
        have hchild := allMoves_sound _ hv.2 mv
        have hroot' := refine_preserves_firstOne p s (some mv) hhole hroot
        have hno' := weightedTNFNoAssignedHalt_refine p s mv hno
        rcases ih mv (refine p s (some mv)) hroot' hno' hchild m hcomp with hgood | ⟨e,he,hcompat⟩
        · exact Or.inl hgood
        · exact Or.inr ⟨(mv :: e.1,e.2), by
            simp only [remaining]
            apply List.mem_flatMap.mpr
            refine ⟨mv, BB6.Agent31FourHoleFrontier.allMoves_complete mv, ?_⟩
            exact List.mem_map.mpr ⟨e,he,rfl⟩, hcompat⟩

def pick (xs : List PartialAudit) (mv : Move) : PartialAudit :=
  xs[12*mv.write.toNat+6*mv.right.toNat+mv.next.val]?.getD .unresolved

def prefix : List PathEntry :=
  [(1,(1,false),⟨true,true,2⟩),
   (2,(2,false),⟨true,false,3⟩),
   (3,(3,true),⟨false,false,4⟩),
   (4,(4,true),⟨true,false,5⟩)]

def parent : PartialMachine := (pathEnd root 2 prefix).1

theorem parent_reachable : FirstHolePath parent 6 := by
  have hc : pathOK root 2 prefix = true := by decide
  exact pathOK_sound root 2 prefix FirstHolePath.root hc

theorem parent_root : parent initialSlot = some (some ⟨true,true,1⟩) := by decide

theorem parent_nohalt : weightedTNFNoAssignedHalt parent :=
  pathEnd_nohalt root 2 prefix firstOneCylinder_no_assigned_halt

