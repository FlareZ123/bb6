/-- The nine exact q0 automata-bank parents, in source queue order. -/
def q0NineParentCodes : List Nat := [
  27873198962095784,
  27873199888846492,
  27873199888847168,
  27873199888850548,
  27873199888853928,
  27873199888855280,
  27873199888856632,
  27873199888857308,
  27873199888858660
]

def root52Code : Nat := 27873408715923912

def q0NineRemainingCodes : List Nat :=
  q0CheckpointCodes.filter (fun c => !(q0NineParentCodes.contains c))

def q0AfterRoot52Codes : List Nat :=
  q0NineRemainingCodes.filter (fun c => c != root52Code)

def raw11AfterNineRoot52Codes : List Nat :=
  BB6.Agent47Raw11Route.checkpointCodes.filter
    (fun c => !(q0NineParentCodes.contains c) && c != root52Code)

theorem q0_checkpoint_nodup : q0CheckpointCodes.Nodup := by
  decide +kernel

theorem q0_checkpoint_length : q0CheckpointCodes.length = 157 := by
  decide +kernel

theorem q0_checkpoint_perm_raw11 :
    q0CheckpointCodes.Perm BB6.Agent47Raw11Route.checkpointCodes := by
  decide +kernel

theorem q0_nine_parent_codes_nodup : q0NineParentCodes.Nodup := by
  decide +kernel

theorem q0_nine_parent_codes_in_checkpoint :
    ∀ c ∈ q0NineParentCodes, c ∈ q0CheckpointCodes := by
  decide +kernel

theorem q0_nine_remaining_length : q0NineRemainingCodes.length = 148 := by
  decide +kernel

theorem root52_in_q0_nine_remaining :
    root52Code ∈ q0NineRemainingCodes := by
  decide +kernel

theorem q0_after_root52_length : q0AfterRoot52Codes.length = 147 := by
  decide +kernel

theorem raw11_after_nine_root52_length :
    raw11AfterNineRoot52Codes.length = 147 := by
  decide +kernel

/-- The 147 Raw11 checkpoint residuals are exactly the q0 queue remainder
    after the nine parent Covers and the additional root52 Cover. -/
theorem q0_after_root52_perm_raw11 :
    q0AfterRoot52Codes.Perm raw11AfterNineRoot52Codes := by
  decide +kernel

#print axioms q0_checkpoint_perm_raw11
#print axioms q0_nine_remaining_length
#print axioms q0_after_root52_perm_raw11

