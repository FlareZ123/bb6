import SevenRoster

set_option maxRecDepth 40000
set_option maxHeartbeats 0
namespace BB6.Agent47SevenSideWitnesses
open BB6Coverage BB6.Agent13BlankDelay BB6.Agent50RootFrontier BB6.Agent47SevenRoster
open BB6Coverage.Agent50SideCycle

/-- Row code 0 is unassigned; 1..24 index the concrete ordinary alphabet. -/
def decodeRow (n : Nat) : Option (Option Move) :=
  if n = 0 then none else (allMoves[n-1]?).map some

def decodeRows (ns : List Nat) : PackedTable := ns.map decodeRow

structure SideWitness where
  rows : List Nat
  entry : Nat
  period : Nat
  right : Bool
  boundary : Int

def SideWitness.table (w : SideWitness) : PackedTable := decodeRows w.rows

def SideWitness.check (w : SideWitness) : Bool :=
  decide (0 < w.period) &&
  finiteSideCycleCheck (unpackTable w.table) w.entry w.period w.right w.boundary

theorem SideWitness.sound (w : SideWitness) (h : w.check = true) :
    ∀ m, compatible (unpackTable w.table) m → WeightedBound 7014 m := by
  have hh : 0 < w.period ∧ finiteSideCycleCheck (unpackTable w.table)
      w.entry w.period w.right w.boundary = true := by
    simpa only [SideWitness.check,Bool.and_eq_true,decide_eq_true_eq] using h
  intro m hm
  exact weighted_never 7014 m (finiteSideCycleCheck_sound (unpackTable w.table)
    w.entry w.period w.right w.boundary hh.1 hh.2 m hm)

