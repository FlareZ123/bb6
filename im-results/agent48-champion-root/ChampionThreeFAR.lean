import FastFAR
import ChampionParentCover

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace BB6.Agent48Three
open BB6Coverage BB6Coverage.FAR

/-- Transition codes in state-major order: four write/direction pairs per
target state, with 24 representing an unassigned row. -/
def threeTable (f a b : Nat) : PartialMachine :=
  fromCodes [7,a,11,b,14,21,3,16,12,11,f,17]

theorem farCover {d : Nat} (C : Data d) (p : PartialMachine)
    (h : C.fastValid p = true) : Cover NeverHalts p :=
  .leaf _ (fun m hm => C.sound p (C.fastValid_sound p h) m hm)

