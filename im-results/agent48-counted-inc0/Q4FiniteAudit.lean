/-- Equality of finite marked-cell sets, independent of list order. -/
def sameMarkedSet (xs ys : List Int) : Bool :=
  xs.all (fun x => x ∈ ys) && ys.all (fun y => y ∈ xs)

/-- Kernel-reducing exact replay of the original TM63 table from the
