import Std.Tactic
import PostResetCarryPairInvariant
import SourceCarryAffineBridge

/-!
# Paired carry state / affine output-map bridge

This file identifies the finite paired-carry state machine in
PostResetCarryPairInvariant.lean with the arbitrary-length affine carry
transducers in SourceCarryAffineBridge.lean.

It proves the missing state-to-run-word interface for both L and R.  It does
not claim that the authentic root's shifted S-window language is closed; that
root-specific phase/word invariant remains a separate obligation.
-/

namespace BB6PostResetCarryOutputMap

open BB6PostResetCarry
open BB6.Agent48SourceCarryAffineBridge

/-- Convert a finite word over Fin 3 digit pairs to the integer-pair alphabet
    used by the affine carry transducers. -/
def toIntPairs : List (Fin 3 × Fin 3) → List (Int × Int)
  | [] => []
  | (x,y)::xs =>
      (Int.ofNat x.val, Int.ofNat y.val) :: toIntPairs xs

def leftTx (s : State) (x : Fin 3) : Int :=
  Int.ofNat x.val - Int.ofNat s.py.val + leftA s.la

def leftTy (s : State) : Int :=
  Int.ofNat s.py.val

def rightTx (s : State) (x : Fin 3) : Int :=
  -(Int.ofNat x.val) - Int.ofNat s.px.val - Int.ofNat s.py.val +
    rightA s.ra

def rightTy (s : State) : Int :=
  Int.ofNat s.px.val + Int.ofNat s.py.val + rightB s.ra

/-- One L output pair emitted from the paired state on an input pair. -/
def leftOutputPair (s : State) (x y : Fin 3) : Int × Int :=
  (leftTx s x % 3, leftTy s % 3)

/-- One R output pair emitted from the paired state on an input pair. -/
def rightOutputPair (s : State) (x y : Fin 3) : Int × Int :=
  (rightTx s x % 3, rightTy s % 3)

/-- The complete L output stream generated by the finite state machine. -/
def runLeftOutput (s : State) : List (Fin 3 × Fin 3) → List (Int × Int)
  | [] => []
  | (x,y)::xs =>
      leftOutputPair s x y :: runLeftOutput (step s x y) xs

/-- The complete R output stream generated by the finite state machine. -/
def runRightOutput (s : State) : List (Fin 3 × Fin 3) → List (Int × Int)
  | [] => []
  | (x,y)::xs =>
      rightOutputPair s x y :: runRightOutput (step s x y) xs

/-- On the bounded carry numerators occurring in the paired state machine,
    the custom floor quotient agrees with Lean's Euclidean quotient. -/
theorem floorDiv3_eq_ediv_small (z : Int)
    (hlo : -9 ≤ z) (hhi : z ≤ 5) :
    floorDiv3 z = z / 3 := by
  interval_cases z <;> norm_num [floorDiv3]

theorem leftNext_eq_ediv (s : State) (x : Fin 3) :
    leftNext s x = leftTx s x / 3 := by
  cases s with
  | mk px py la ra =>
      fin_cases x <;> fin_cases py <;> fin_cases la <;>
        norm_num [leftNext, leftTx, leftA, floorDiv3]

theorem rightANext_eq_ediv (s : State) (x : Fin 3) :
    rightANext s x = rightTx s x / 3 := by
  cases s with
  | mk px py la ra =>
      fin_cases x <;> fin_cases px <;> fin_cases py <;> fin_cases ra <;>
        norm_num [rightANext, rightTx, rightA, floorDiv3]

theorem rightBNext_eq_ediv (s : State) :
    rightBNext s = rightTy s / 3 := by
  cases s with
  | mk px py la ra =>
      fin_cases px <;> fin_cases py <;> fin_cases ra <;>
        norm_num [rightBNext, rightTy, rightB, floorDiv3]

/-- Decoding the L carry after one step recovers the exact quotient carry. -/
theorem leftA_step (s : State) (h : Allowed s) (x y : Fin 3) :
    leftA (step s x y).la = leftNext s x := by
  rcases leftNext_valid s h x with h0 | h1
  · simp [step, encodeLeft, leftA, h0]
  · simp [step, encodeLeft, leftA, h1]

/-- The encoded R carry pair after one step decodes to the exact quotient
    pair used by the arbitrary-length R transducer. -/
theorem rightAB_step (s : State) (h : Allowed s) (x y : Fin 3) :
    (rightA (step s x y).ra, rightB (step s x y).ra) =
      (rightANext s x, rightBNext s) := by
  rcases rightNext_valid s h x with h0 | h1 | h2 | h3
  · rcases h0 with ⟨ha, hb⟩
    simp [step, encodeRight, rightA, rightB, ha, hb]
  · rcases h1 with ⟨ha, hb⟩
    simp [step, encodeRight, rightA, rightB, ha, hb]
  · rcases h2 with ⟨ha, hb⟩
    simp [step, encodeRight, rightA, rightB, ha, hb]
  · rcases h3 with ⟨ha, hb⟩
    simp [step, encodeRight, rightA, rightB, ha, hb]

/-- Every finite L state-machine output is exactly the L carry-transducer
    output on the same raw digit-pair word. -/
theorem runLeftOutput_eq_carryOutputPairs
    (s : State) (h : Allowed s) (word : List (Fin 3 × Fin 3)) :
    runLeftOutput s word =
      BB6.Agent48SourceCarryAffineBridge.leftCarryOutputPairs
        (Int.ofNat s.py.val) (leftA s.la) 0 (toIntPairs word) := by
  induction word generalizing s with
  | nil => rfl
  | cons xy rest ih =>
      rcases xy with ⟨x,y⟩
      have hstep : Allowed (step s x y) := allowed_step s h x y
      have hleft : leftA (step s x y).la = leftNext s x :=
        leftA_step s h x y
      have hdiv : leftNext s x = leftTx s x / 3 :=
        leftNext_eq_ediv s x
      have hty : leftTy s / 3 = 0 := by
        dsimp [leftTy]
        omega
      simp only [runLeftOutput, leftOutputPair, leftTx, leftTy,
        toIntPairs,
        BB6.Agent48SourceCarryAffineBridge.leftCarryOutputPairs]
      congr 1
      · rfl
      · rw [ih (step s x y) hstep]
        have hprev :
            Int.ofNat (step s x y).py.val = Int.ofNat y.val := rfl
        have hcarry :
            leftA (step s x y).la = leftTx s x / 3 := by
          rw [hleft, hdiv]
        rw [hprev, hcarry, hty]

/-- Every finite R state-machine output is exactly the R carry-transducer
    output on the same raw digit-pair word. -/
theorem runRightOutput_eq_carryOutputPairs
    (s : State) (h : Allowed s) (word : List (Fin 3 × Fin 3)) :
    runRightOutput s word =
      BB6.Agent48SourceCarryAffineBridge.rightCarryOutputPairs
        (Int.ofNat s.px.val) (Int.ofNat s.py.val)
        (rightA s.ra) (rightB s.ra) (toIntPairs word) := by
  induction word generalizing s with
  | nil => rfl
  | cons xy rest ih =>
      rcases xy with ⟨x,y⟩
      have hstep : Allowed (step s x y) := allowed_step s h x y
      have hright :
          (rightA (step s x y).ra, rightB (step s x y).ra) =
            (rightANext s x, rightBNext s) :=
        rightAB_step s h x y
      have hdivA : rightANext s x = rightTx s x / 3 :=
        rightANext_eq_ediv s x
      have hdivB : rightBNext s = rightTy s / 3 :=
        rightBNext_eq_ediv s
      simp only [runRightOutput, rightOutputPair, rightTx, rightTy,
        toIntPairs,
        BB6.Agent48SourceCarryAffineBridge.rightCarryOutputPairs]
      congr 1
      · rfl
      · rw [ih (step s x y) hstep]
        have hprevX :
            Int.ofNat (step s x y).px.val = Int.ofNat x.val := rfl
        have hprevY :
            Int.ofNat (step s x y).py.val = Int.ofNat y.val := rfl
        rw [hprevX, hprevY, hright.1, hright.2, hdivA, hdivB]

/-- Finite automaton fact: from any allowed paired-carry state, every
    three-symbol continuation visits the seed-label set at least once.
    This is a carry-state recurrence statement only; it does not assert that
    the corresponding three-symbol input is a reset word or has
    nonmonochromatic output. -/
theorem allowed_three_step_seed_hit
    (s : State) (h : Allowed s)
    (x1 y1 x2 y2 x3 y3 : Fin 3) :
    Seed (step s x1 y1) ∨
    Seed (step (step s x1 y1) x2 y2) ∨
    Seed (step (step (step s x1 y1) x2 y2) x3 y3) := by
  decide

#print axioms runLeftOutput_eq_carryOutputPairs
#print axioms runRightOutput_eq_carryOutputPairs
#print axioms allowed_three_step_seed_hit

end BB6PostResetCarryOutputMap
