def keys : List (Fin 25 × Fin 25 × Fin 25) :=
  cases.map (fun c => (c.d0,c.b1,c.f0))

theorem cases_count : cases.length = 123 := by decide

theorem all_checked :
    cases.all (fun c =>
      BB6.Agent4Automata.check (table c.d0 c.b1 c.f0) c.cert) = true := by decide

theorem source_compatible (d0 b1 f0 : Fin 25) (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (hd0 : m (3,false) = decode d0)
    (hb1 : m (1,true) = decode b1)
    (hf0 : m (5,false) = decode f0) : compatible (table d0 b1 f0) m := by
  have e0s : raw10Remainder[27]! (0,false) = [decode 8] := by decide
  have e1s : raw10Remainder[27]! (1,false) = [decode 11] := by decide
  have e2s : raw10Remainder[27]! (2,false) = [decode 13] := by decide
  have e3s : raw10Remainder[27]! (2,true) = [decode 13] := by decide
  have h0 : m (0,false) = decode 8 := by simpa [e0s] using hm (0,false)
  have h1 : m (1,false) = decode 11 := by simpa [e1s] using hm (1,false)
  have h2 : m (2,false) = decode 13 := by simpa [e2s] using hm (2,false)
  have h3 : m (2,true) = decode 13 := by simpa [e3s] using hm (2,true)
  intro s t ht
  obtain ⟨q,b⟩ := s
  have hq : q=0 ∨ q=1 ∨ q=2 ∨ q=3 ∨ q=4 ∨ q=5 := by omega
  rcases hq with rfl|rfl|rfl|rfl|rfl|rfl <;>
    cases b <;> simp [table] at ht ⊢ <;> simp_all

theorem source_never (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (d0 b1 f0 : Fin 25)
    (hd0 : m (3,false) = decode d0)
    (hb1 : m (1,true) = decode b1)
    (hf0 : m (5,false) = decode f0)
    (hp : (d0,b1,f0) ∈ keys) : NeverHalts m := by
  change (d0,b1,f0) ∈ cases.map (fun c => (c.d0,c.b1,c.f0)) at hp
  obtain ⟨c,hmem,heq⟩ := List.mem_map.mp hp
  have hcheck : BB6.Agent4Automata.check
      (table c.d0 c.b1 c.f0) c.cert = true :=
    List.all_eq_true.mp all_checked c hmem
  obtain ⟨a,b,f,w⟩ := c
  dsimp at heq hcheck
  simp only [Prod.mk.injEq] at heq
  rcases heq with ⟨rfl,rfl,rfl⟩
  exact BB6.Agent4Automata.never (table a b f) w hcheck m
    (source_compatible a b f m hm hd0 hb1 hf0)

theorem source_bound (B : Nat) (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (d0 b1 f0 : Fin 25)
    (hd0 : m (3,false) = decode d0)
    (hb1 : m (1,true) = decode b1)
    (hf0 : m (5,false) = decode f0)
    (hp : (d0,b1,f0) ∈ keys) : WeightedBound B m :=
  weighted_of_never B m (source_never m hm d0 b1 f0 hd0 hb1 hf0 hp)

