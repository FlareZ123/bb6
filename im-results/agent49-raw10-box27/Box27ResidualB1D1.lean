def keys : List (Fin 25 × Fin 25 × Fin 25) :=
  cases.map (fun c => (c.d0,c.x,c.y))

theorem case_count : cases.length = 384 := by decide
theorem all_checked :
    cases.all (fun c =>
      BB6.Agent4Automata.check (table c.d0 c.x c.y) c.cert) = true := by decide

theorem source_compatible (d0 x y : Fin 25) (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (hd0 : m (3,false) = decode d0)
    (hx : m (1,true) = decode x)
    (hy : m (3,true) = decode y) : compatible (table d0 x y) m := by
  have e0 : raw10Remainder[27]! (0,false) = [decode 8] := by decide
  have e1 : raw10Remainder[27]! (1,false) = [decode 11] := by decide
  have e2 : raw10Remainder[27]! (2,false) = [decode 13] := by decide
  have e3 : raw10Remainder[27]! (2,true) = [decode 13] := by decide
  have h0 : m (0,false) = decode 8 := by simpa [e0] using hm (0,false)
  have h1 : m (1,false) = decode 11 := by simpa [e1] using hm (1,false)
  have h2 : m (2,false) = decode 13 := by simpa [e2] using hm (2,false)
  have h3 : m (2,true) = decode 13 := by simpa [e3] using hm (2,true)
  intro s t ht
  obtain ⟨q,b⟩ := s
  have hq : q=0 ∨ q=1 ∨ q=2 ∨ q=3 ∨ q=4 ∨ q=5 := by omega
  rcases hq with rfl|rfl|rfl|rfl|rfl|rfl <;>
    cases b <;> simp [table] at ht ⊢ <;> simp_all

theorem source_never (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (d0 x y : Fin 25)
    (hd0 : m (3,false) = decode d0)
    (hx : m (1,true) = decode x)
    (hy : m (3,true) = decode y)
    (hp : (d0,x,y) ∈ keys) : NeverHalts m := by
  change (d0,x,y) ∈ cases.map (fun c => (c.d0,c.x,c.y)) at hp
  obtain ⟨c,hmem,heq⟩ := List.mem_map.mp hp
  have hcheck : BB6.Agent4Automata.check
      (table c.d0 c.x c.y) c.cert = true :=
    List.all_eq_true.mp all_checked c hmem
  obtain ⟨a,b,e,w⟩ := c
  dsimp at heq hcheck
  simp only [Prod.mk.injEq] at heq
  rcases heq with ⟨rfl,rfl,rfl⟩
  exact BB6.Agent4Automata.never (table a b e) w hcheck m
    (source_compatible a b e m hm hd0 hx hy)

theorem source_bound (B : Nat) (m : Machine)
    (hm : Fits raw10Remainder[27]! m)
    (d0 x y : Fin 25)
    (hd0 : m (3,false) = decode d0)
    (hx : m (1,true) = decode x)
    (hy : m (3,true) = decode y)
    (hp : (d0,x,y) ∈ keys) : WeightedBound B m :=
  weighted_of_never B m (source_never m hm d0 x y hd0 hx hy hp)

