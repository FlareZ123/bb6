def table : PartialMachine := fun s => match s with
  | (0,false) => some (some ⟨true,true,1⟩)
  | (0,true) => some (some ⟨true,true,3⟩)
  | (1,false) => some (some ⟨true,true,2⟩)
  | (1,true) => some (some ⟨true,true,4⟩)
  | (2,false) => some (some ⟨false,false,0⟩)
  | (2,true) => none
  | (3,false) => some (some ⟨true,false,0⟩)
  | (3,true) => some (some ⟨true,false,1⟩)
  | (4,false) => some (some ⟨true,false,5⟩)
  | (4,true) => some (some ⟨false,true,3⟩)
  | (5,false) => some (some ⟨false,true,0⟩)
  | (5,true) => some (some ⟨false,false,5⟩)
  | _ => none
