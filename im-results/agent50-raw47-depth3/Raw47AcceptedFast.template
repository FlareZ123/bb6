def closed : List {p : PartialMachine // ∀ m, TNFQuotientCompatible p m → WeightedBound 10006 m} :=
[
@@ENTRIES@@
]

def keys : KeySet := @@TREE@@
theorem keys_eq : keys.elements = closed.map (fun a => tableCode a.val) := by decide +kernel

def isClosed (p : PartialMachine) : Bool := keys.contains (tableCode p)

theorem isClosed_sound {p : PartialMachine} (h : isClosed p = true)
    (m : Machine) (hm : TNFQuotientCompatible p m) : WeightedBound 10006 m := by
  have hk := KeySet.contains_sound h
  rw [keys_eq] at hk
  obtain ⟨a,_,ha⟩ := List.mem_map.mp hk
  have he : a.val = p := tableCode_inj ha
  rw [← he] at hm
  exact a.property m hm

def remaining := canonicalRemaining.filter fun e => !(isClosed e.2)

theorem closed_count : closed.length = @@N@@ := by decide +kernel

theorem remaining_count : remaining.length = @@REMAIN@@ := by decide +kernel

theorem local_sound (m : Machine) (hm : TNFQuotientCompatible parent m) :
    WeightedBound 10006 m ∨ ∃ e ∈ remaining, TNFQuotientCompatible e.2 m := by
  rcases canonical_local_sound_84 m hm with hb | ⟨e,he,hs⟩
  · exact Or.inl (fun n d h halt => Nat.le_trans (hb n d h halt) (by decide))
  · cases hc : isClosed e.2 with
    | true => exact Or.inl (isClosed_sound hc m hs)
    | false => exact Or.inr ⟨e,List.mem_filter.mpr ⟨he,by simp [hc]⟩,hs⟩
