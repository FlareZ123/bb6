import BB429Rank
import Lean.Elab.Tactic.Omega

namespace BB429RootMod16x8

/-- Residue pairs modulo 16 x 8 closed under every possible nonhalting
transition of the six-state root machine. Generated by finite closure and
then checked by the transition-preservation theorem below. -/
def allowedPairs : List (Nat × Nat) := [
  (0,0),
  (0,2),
  (0,4),
  (0,6),
  (1,1),
  (1,2),
  (2,2),
  (3,1),
  (3,2),
  (3,3),
  (3,5),
  (3,7),
  (4,2),
  (5,0),
  (5,1),
  (5,2),
  (5,3),
  (5,4),
  (5,5),
  (5,7),
  (6,2),
  (7,2),
  (7,3),
  (8,2),
  (9,0),
  (9,1),
  (9,2),
  (9,4),
  (9,5),
  (9,6),
  (10,2),
  (11,2),
  (11,6),
  (11,7),
  (12,2),
  (13,0),
  (13,1),
  (13,2),
  (13,3),
  (13,4),
  (13,5),
  (13,6),
  (13,7),
  (14,2),
  (15,2),
  (15,3)
]

def Allowed (u w : Nat) : Prop :=
  (u % 16, w % 8) ∈ allowedPairs

set_option maxHeartbeats 4000000 in
theorem allowed_step (u w a b : Nat)
    (h : Allowed u w) (hs : BB429.next (u,w) = some (a,b)) :
    Allowed a b := by
  simp only [BB429.next] at hs
  repeat' (split at hs <;> try contradiction)
  all_goals simp_all [Allowed, allowedPairs, Prod.mk.injEq, Option.some.injEq]
  all_goals omega

theorem initial_allowed : Allowed 0 0 := by
  simp [Allowed, allowedPairs]

theorem all_blank_returns_allowed (n : Nat) (a b : Nat)
    (h : BB429.run n (0,0) = some (a,b)) : Allowed a b := by
  induction n generalizing a b with
  | zero =>
      simp only [BB429.run, Option.some.injEq, Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      exact initial_allowed
  | succ n ih =>
      simp only [BB429.run] at h
      cases hprev : BB429.run n (0,0) with
      | none => simp [hprev] at h
      | some s =>
          obtain ⟨u,w⟩ := s
          simp only [hprev, Option.bind_some] at h
          exact allowed_step u w a b (ih u w hprev) h

#print axioms allowed_step
#print axioms all_blank_returns_allowed

end BB429RootMod16x8
