theorem far_child4 (B : Nat) (f mv : Move) (C : FAR.Data 4)
    (h : C.fastValid (child f mv) = true) :
    Cover (WeightedBound B) (child f mv) :=
  .leaf _ (fun m hm => weighted_never B m (C.sound _ (C.fastValid_sound _ h) m hm))

