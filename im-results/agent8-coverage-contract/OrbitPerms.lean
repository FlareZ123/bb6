def fwd (i : Fin 120) (s : Fin 6) : Fin 6 :=
  (perms.getD i.val #[]).getD s.val 0

def bwd (i : Fin 120) (s : Fin 6) : Fin 6 :=
  (invPerms.getD i.val #[]).getD s.val 0

theorem fwd_bwd_all : ∀ i : Fin 120, ∀ s : Fin 6, bwd i (fwd i s) = s := by
  decide

theorem bwd_fwd_all : ∀ i : Fin 120, ∀ s : Fin 6, fwd i (bwd i s) = s := by
  decide

@[simp] theorem fwd_zero (i : Fin 120) : fwd i 0 = 0 := by
  have hzero : ∀ j : Fin 120, fwd j 0 = 0 := by decide
  exact hzero i

/-- A source-reducible bijection witness for every enumerated permutation. -/
def rootedPerm (i : Fin 120) : StatePerm := {
  forward := fwd i
  backward := bwd i
  leftInverse := fwd_bwd_all i
  rightInverse := bwd_fwd_all i
}

#print axioms fwd_bwd_all
#print axioms bwd_fwd_all
#print axioms fwd_zero
end BB6Coverage
